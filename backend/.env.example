PORT=8787
BACKEND_SECRET=replace-with-a-long-random-secret-at-least-24-chars
# Free-tier hosted AI (recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# LLM_PROVIDER=auto
# GEMINI_MODEL=gemini-2.0-flash
# Paid fallback (optional):
# ANTHROPIC_API_KEY=sk-ant-api03-...
DAILY_CREDITS=1200
USAGE_RESET_HOUR_UTC=0
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_USER_PER_MIN=90
# Optional: cap per Distill install (guest id) below RATE_LIMIT_USER_PER_MIN when set (>0).
# RATE_LIMIT_PER_INSTALL_PER_MIN=60
# Guest token minting (POST /v1/auth/guest) — per IP and per installId.
RATE_LIMIT_GUEST_AUTH_IP_PER_MIN=40
RATE_LIMIT_GUEST_AUTH_PER_INSTALL_PER_MIN=15
CORS_ORIGIN=*
# Hosted API: set PUBLIC_BACKEND=1 and list allowed chrome-extension:// origins (comma-separated).
# With PUBLIC_BACKEND=1 and CORS_ORIGIN=*, localhost tool origins stay allowed; chrome-extension is allowlist-only
# on non-loopback Host (production). On Host localhost / 127.0.0.1 any extension id is allowed for local dev.
# PUBLIC_BACKEND=0
# EXTENSION_CORS_ORIGINS=chrome-extension://<your-extension-id>
# Extension default prod URL: edit extension/utils/backendEnv.js — `prod` must not equal DISTILL_BACKEND_PROD_UNCONFIGURED.
# If you explicitly want to allow non-local origins, set a comma-separated allowlist:
# CORS_ORIGIN=chrome-extension://<YOUR_EXTENSION_ID>,http://localhost:8787
TOKEN_TTL_SEC=2592000
# Optional. Default: backend/data/state.json (relative to the backend package directory).
# Ignored when DATABASE_URL is set (usage + token_version live in Postgres).
# STATE_FILE_PATH=./data/state.json
# Supabase Postgres (Settings → Database → URI, use "Transaction" pooler for serverless-friendly pooling).
# When unset, the server uses STATE_FILE_PATH JSON for usage + token versions (fine for single-machine dev).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
ADMIN_SECRET=
# Admin routes are hidden unless explicitly enabled.
# Set both:
# - ENABLE_ADMIN_ROUTES=1
# - ADMIN_SECRET=<long random string>
ENABLE_ADMIN_ROUTES=0
KILL_SWITCH_AI_RUN=0
KILL_SWITCH_GUEST_AUTH=0
KILL_SWITCH_USAGE=0
# Optional NDJSON access log (one JSON object per line). Relative paths resolve under backend/.
# REQUEST_LOG_FILE=./data/access.ndjson
# REQUEST_LOG_MAX_BYTES=10485760
# REQUEST_LOG_MAX_FILES=5
# Fly / Docker: use stdout (platform collects logs). Local: REQUEST_LOG_STDOUT=1
# REQUEST_LOG_STDOUT=0
# Comma-separated paths to omit from access logs. Set to "-" to log everything (including /healthz).
# REQUEST_LOG_SKIP_PATHS=/healthz,/health,/metrics
